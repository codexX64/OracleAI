{
  "$schema": "https://raw.githubusercontent.com/CodexX64/hub-registry/main/schema/hub-extension.v1.json",
  "manifestVersion": 1,
  "id": "oracle",
  "name": "Oracle AI",
  "version": "1.2.0",
  "description": "IA locale (Ollama) en duel contre Claude, ChatGPT, Kimi ou un autre : un juge déterministe départage sur des critères mesurables.",
  "icon": "sparkle",
  "repository": "https://github.com/CodexX64/oracle",
  "license": "MIT",
  "minHubVersion": "0.5.63",
  "install": {
    "type": "compose",
    "compose": "deploy/compose.hub.yml",
    "remote": {
      "supported": true,
      "label": "Adresse d'Oracle",
      "placeholder": "http://192.0.2.50:8112",
      "defaultPort": 8112,
      "setupHelp": "Pour un Oracle déjà en service ailleurs : poser ORACLE_HUB_TOKEN dans son environnement, redémarrer, puis coller ce jeton ici."
    },
    "healthcheck": {
      "type": "http",
      "path": "/healthz",
      "expect": 200,
      "timeout": "5s"
    },
    "arch": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "ramMb": 256,
      "cpu": 0.5,
      "diskMb": 512
    },
    "ports": [
      {
        "name": "http",
        "container": 8112,
        "protocol": "http",
        "expose": "proxy"
      }
    ],
    "volumes": [
      {
        "name": "data",
        "path": "/app/data"
      }
    ]
  },
  "config": [
    {
      "key": "IMAGE_TAG",
      "label": "Version de l'image",
      "type": "string",
      "default": "latest",
      "advanced": true,
      "help": "Étiquette de l'image publiée sur ghcr.io."
    },
    {
      "key": "HUB_TOKEN",
      "label": "Jeton de service",
      "type": "secret",
      "generate": "random:32",
      "help": "Créé par le Hub à l'installation. Il ouvre l'API d'Oracle au Hub — jamais les comptes."
    },
    {
      "key": "OLLAMA_MODEL",
      "label": "Modèle local par défaut",
      "type": "select",
      "optionsFrom": {
        "from": {
          "capability": "llm.chat"
        },
        "method": "GET",
        "path": "/api/tags",
        "select": "$.models",
        "map": {
          "value": "$.name",
          "label": "$.name"
        }
      },
      "help": "Les modèles installés sur l'Ollama du Hub. Changeable à la volée dans l'interface d'Oracle."
    },
    {
      "key": "ADVERSAIRE",
      "label": "Adversaire du duel",
      "type": "select",
      "default": "claude-code",
      "required": true,
      "options": [
        {
          "value": "claude-code",
          "label": "Claude — par Claude Code (ton abonnement)"
        },
        {
          "value": "claude-api",
          "label": "Claude — par l'API Anthropic"
        },
        {
          "value": "openai",
          "label": "ChatGPT (OpenAI)"
        },
        {
          "value": "kimi",
          "label": "Kimi (Moonshot)"
        },
        {
          "value": "mistral",
          "label": "Mistral"
        },
        {
          "value": "deepseek",
          "label": "DeepSeek"
        },
        {
          "value": "gemini",
          "label": "Gemini (Google)"
        },
        {
          "value": "groq",
          "label": "Groq"
        },
        {
          "value": "openrouter",
          "label": "OpenRouter (des centaines de modèles)"
        },
        {
          "value": "compatible",
          "label": "Autre API compatible OpenAI"
        }
      ],
      "help": "Qui affronte le modèle local. Sans clé ni jeton, Oracle reste utilisable en local seul, sans duel."
    },
    {
      "key": "CLAUDE_CODE_TOKEN",
      "label": "Jeton Claude Code",
      "type": "secret",
      "showIf": {
        "ADVERSAIRE": [
          "claude-code"
        ]
      },
      "help": "Sur une machine où Claude Code est connecté à ton abonnement : « claude setup-token », puis colle le jeton ici. Aucune clé d'API n'est utilisée."
    },
    {
      "key": "ADVERSAIRE_CLE",
      "label": "Clé d'API de l'adversaire",
      "type": "secret",
      "showIf": {
        "ADVERSAIRE": [
          "claude-api",
          "openai",
          "kimi",
          "mistral",
          "deepseek",
          "gemini",
          "groq",
          "openrouter",
          "compatible"
        ]
      },
      "help": "La clé du fournisseur choisi : console.anthropic.com, platform.openai.com, platform.moonshot.ai, console.mistral.ai, platform.deepseek.com, aistudio.google.com, console.groq.com ou openrouter.ai."
    },
    {
      "key": "ADVERSAIRE_URL",
      "label": "Adresse de l'API",
      "type": "string",
      "default": "",
      "showIf": {
        "ADVERSAIRE": [
          "compatible"
        ]
      },
      "help": "Se termine par /v1. Ex. un vLLM, un LM Studio ou un autre serveur compatible OpenAI."
    },
    {
      "key": "ADVERSAIRE_NOM",
      "label": "Nom affiché de l'adversaire",
      "type": "string",
      "default": "",
      "showIf": {
        "ADVERSAIRE": [
          "compatible"
        ]
      },
      "help": "Ce qu'Oracle écrit sur la carte de l'adversaire."
    },
    {
      "key": "ADVERSAIRE_MODELE",
      "label": "Modèle de l'adversaire",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Vide : tu le choisis dans les réglages d'Oracle, dans la liste que le fournisseur renvoie. Pour Claude, seuls opus, sonnet et haiku passent le garde-fou."
    }
  ],
  "api": {
    "baseUrl": "{{service.url}}",
    "auth": {
      "type": "bearer",
      "token": "{{service.token}}",
      "localToken": "HUB_TOKEN",
      "remoteToken": "HUB_TOKEN"
    }
  },
  "capabilities": {
    "provides": [
      "ai.duel"
    ],
    "requires": [
      "llm.chat"
    ],
    "accepts": [
      "memory.learn"
    ]
  },
  "triggers": [],
  "actions": [
    {
      "id": "duel",
      "name": "Lancer un duel",
      "description": "La même question au modèle local et à l'adversaire configuré ; le juge déterministe départage.",
      "icon": "zap",
      "group": "Duel",
      "capability": "ai.duel",
      "risk": "reversible",
      "params": [
        {
          "key": "question",
          "label": "Question",
          "type": "expression",
          "required": true
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/duel",
        "body": {
          "q": "{{params.question}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "object",
            "properties": {
              "winner": {
                "type": "string"
              },
              "gap": {
                "type": "number"
              }
            }
          }
        }
      },
      "sample": {
        "verdict": {
          "winner": "qwen",
          "gap": 0.4
        }
      }
    },
    {
      "id": "stats",
      "name": "Palmarès des duels",
      "description": "Totaux, taux de victoire du modèle local, scores moyens.",
      "icon": "chart",
      "group": "Duel",
      "risk": "read",
      "idempotent": true,
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/stats"
      },
      "output": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "judged": {
            "type": "number"
          },
          "qwen_winrate": {
            "type": "number"
          },
          "avg_qwen": {
            "type": "number"
          },
          "avg_claude": {
            "type": "number"
          }
        }
      },
      "sample": {
        "total": 42,
        "judged": 31,
        "qwen_winrate": 45,
        "avg_qwen": 7.1,
        "avg_claude": 7.6
      }
    }
  ],
  "probes": [
    {
      "id": "reachable",
      "name": "Joignable",
      "kind": "state",
      "request": {
        "method": "GET",
        "path": "/healthz"
      },
      "value": "$.ok",
      "states": {
        "ok": [
          true,
          "true",
          "ok"
        ]
      },
      "interval": "30s"
    },
    {
      "id": "ollama",
      "name": "Ollama joignable",
      "kind": "state",
      "request": {
        "method": "GET",
        "path": "/api/health"
      },
      "value": "$.ollama",
      "states": {
        "ok": [
          true,
          "true"
        ]
      },
      "interval": "1m"
    },
    {
      "id": "duels",
      "name": "Duels enregistrés",
      "kind": "gauge",
      "unit": "duels",
      "request": {
        "method": "GET",
        "path": "/api/stats"
      },
      "value": "$.total",
      "interval": "5m"
    }
  ],
  "permissions": {
    "dockerSocket": "none",
    "privileged": false,
    "hostNetwork": false,
    "capAdd": [],
    "egress": [
      "claude.ai",
      "api.anthropic.com",
      "api.openai.com",
      "api.moonshot.ai",
      "api.mistral.ai",
      "api.deepseek.com",
      "generativelanguage.googleapis.com",
      "api.groq.com",
      "openrouter.ai"
    ]
  },
  "ai": {
    "exposeActions": true,
    "hints": "Oracle départage une IA locale et un adversaire (Claude, ChatGPT, Kimi, Mistral…) avec un juge déterministe — jamais un LLM. « Palmarès des duels » pour les chiffres ; un duel coûte un appel à l'adversaire, donc n'en lance pas en boucle. Les conversations restent privées : Oracle ne raconte à SYNAPSE (si installé) que les verdicts de duel, les modèles téléchargés et les pannes d'Ollama."
  }
}
