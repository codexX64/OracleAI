{
  "$schema": "https://raw.githubusercontent.com/CodexX64/hub-registry/main/schema/hub-extension.v1.json",
  "manifestVersion": 1,
  "id": "oracle",
  "name": "Oracle AI",
  "version": "1.1.0",
  "description": "Dialoguer avec une IA locale (Ollama), et la faire s'affronter contre Claude : un juge déterministe départage sur des critères mesurables.",
  "icon": "sparkle",
  "repository": "https://github.com/CodexX64/oracle",
  "license": "MIT",
  "minHubVersion": "0.4.0",
  "install": {
    "type": "compose",
    "compose": "deploy/compose.hub.yml",
    "remote": {
      "supported": true,
      "label": "Adresse d'Oracle",
      "placeholder": "http://192.0.2.50:8112",
      "defaultPort": 8112,
      "setupHelp": "Pour un Oracle déjà en service ailleurs : poser ORACLE_HUB_TOKEN dans son environnement, redémarrer, puis coller ce jeton ici."
    },
    "healthcheck": {
      "type": "http",
      "path": "/healthz",
      "expect": 200,
      "timeout": "5s"
    },
    "arch": ["amd64", "arm64"],
    "resources": {
      "ramMb": 256,
      "cpu": 0.5,
      "diskMb": 512
    },
    "ports": [
      {
        "name": "http",
        "container": 8112,
        "protocol": "http",
        "expose": "proxy"
      }
    ],
    "volumes": [
      {
        "name": "data",
        "path": "/app/data"
      }
    ]
  },
  "config": [
    {
      "key": "IMAGE_TAG",
      "label": "Version de l'image",
      "type": "string",
      "default": "latest",
      "advanced": true,
      "help": "Étiquette de l'image publiée sur ghcr.io."
    },
    {
      "key": "HUB_TOKEN",
      "label": "Jeton de service",
      "type": "secret",
      "generate": "random:32",
      "help": "Créé par le Hub à l'installation. Il ouvre l'API d'Oracle au Hub — jamais les comptes."
    },
    {
      "key": "OLLAMA_MODEL",
      "label": "Modèle local par défaut",
      "type": "string",
      "default": "qwen3:14b",
      "help": "Le modèle d'Ollama qui répond. Changeable à la volée dans l'interface."
    },
    {
      "key": "CLAUDE_MODE",
      "label": "Accès à Claude (mode duel)",
      "type": "select",
      "default": "api",
      "options": [
        { "value": "api", "label": "Clé API Anthropic" },
        { "value": "cli", "label": "Claude Code sur l'hôte (installation native seulement)" }
      ],
      "help": "En conteneur, seul le mode clé API fonctionne : Claude Code vit sur l'hôte. Sans clé, Oracle reste utilisable en local seul, sans duel."
    },
    {
      "key": "ANTHROPIC_API_KEY",
      "label": "Clé API Anthropic",
      "type": "secret",
      "help": "Seulement pour le mode duel par API. Vide : pas de duel, le chat local fonctionne."
    },
    {
      "key": "CLAUDE_MODEL",
      "label": "Modèle Claude du duel",
      "type": "string",
      "default": "claude-opus-4-8",
      "advanced": true,
      "help": "Un garde-fou refuse tout modèle hors des familles opus, sonnet et haiku."
    }
  ],
  "api": {
    "baseUrl": "{{service.url}}",
    "auth": {
      "type": "bearer",
      "token": "{{service.token}}",
      "localToken": "HUB_TOKEN",
      "remoteToken": "HUB_TOKEN"
    }
  },
  "capabilities": {
    "provides": [
      "ai.duel"
    ],
    "requires": [
      "llm.chat"
    ],
    "accepts": [
      "memory.learn"
    ]
  },
  "triggers": [],
  "actions": [
    {
      "id": "duel",
      "name": "Lancer un duel",
      "description": "La même question au modèle local et à Claude ; le juge déterministe départage.",
      "icon": "zap",
      "group": "Duel",
      "capability": "ai.duel",
      "risk": "reversible",
      "params": [
        {
          "key": "question",
          "label": "Question",
          "type": "expression",
          "required": true
        }
      ],
      "request": {
        "method": "POST",
        "path": "/api/duel",
        "body": {
          "q": "{{params.question}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "object",
            "properties": {
              "winner": { "type": "string" },
              "gap": { "type": "number" }
            }
          }
        }
      },
      "sample": {
        "verdict": { "winner": "qwen", "gap": 0.4 }
      }
    },
    {
      "id": "stats",
      "name": "Palmarès des duels",
      "description": "Totaux, taux de victoire du modèle local, scores moyens.",
      "icon": "chart",
      "group": "Duel",
      "risk": "read",
      "idempotent": true,
      "params": [],
      "request": {
        "method": "GET",
        "path": "/api/stats"
      },
      "output": {
        "type": "object",
        "properties": {
          "total": { "type": "number" },
          "judged": { "type": "number" },
          "qwen_winrate": { "type": "number" },
          "avg_qwen": { "type": "number" },
          "avg_claude": { "type": "number" }
        }
      },
      "sample": { "total": 42, "judged": 31, "qwen_winrate": 45, "avg_qwen": 7.1, "avg_claude": 7.6 }
    }
  ],
  "probes": [
    {
      "id": "reachable",
      "name": "Joignable",
      "kind": "state",
      "request": {
        "method": "GET",
        "path": "/healthz"
      },
      "value": "$.ok",
      "states": {
        "ok": [true, "true", "ok"]
      },
      "interval": "30s"
    },
    {
      "id": "ollama",
      "name": "Ollama joignable",
      "kind": "state",
      "request": {
        "method": "GET",
        "path": "/api/health"
      },
      "value": "$.ollama",
      "states": {
        "ok": [true, "true"]
      },
      "interval": "1m"
    },
    {
      "id": "duels",
      "name": "Duels enregistrés",
      "kind": "gauge",
      "unit": "duels",
      "request": {
        "method": "GET",
        "path": "/api/stats"
      },
      "value": "$.total",
      "interval": "5m"
    }
  ],
  "permissions": {
    "dockerSocket": "none",
    "privileged": false,
    "hostNetwork": false,
    "capAdd": [],
    "egress": ["api.anthropic.com"]
  },
  "ai": {
    "exposeActions": true,
    "hints": "Oracle départage une IA locale et Claude avec un juge déterministe — jamais un LLM. « Palmarès des duels » pour les chiffres ; un duel coûte un appel API Claude, donc n'en lance pas en boucle. Les conversations restent privées : Oracle ne raconte à SYNAPSE (si installé) que les verdicts de duel, les modèles téléchargés et les pannes d'Ollama."
  }
}
