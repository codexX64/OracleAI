# ===== Oracle AI =====

# ---- Ollama (machine qui héberge les modèles locaux) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# ---- Adversaire du duel ----
# claude-code (abonnement, sans clé) · claude-api · openai · kimi · mistral ·
# deepseek · gemini · groq · openrouter · compatible
ADVERSAIRE=claude-code
ADVERSAIRE_CLE=
# vide = choisi dans les réglages d'Oracle, parmi les modèles du fournisseur
ADVERSAIRE_MODELE=
# seulement pour « compatible »
ADVERSAIRE_URL=
ADVERSAIRE_NOM=
# claude-code en conteneur sans session montée : jeton de « claude setup-token »
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_BIN : laisser vide en Docker, le binaire monté est détecté automatiquement
CLAUDE_BIN=

# ---- Docker : dossier home de l'hôte contenant .claude et .local/share/claude ----
HOST_HOME=/home/user
TZ=Europe/Paris

MAX_TOKENS=1024

# ---- Service de mémoire externe (optionnel) ----
MEMORY_URL=
MEMORY_API_KEY=
