# ===== Oracle AI =====

# ---- Ollama (machine qui héberge les modèles locaux) ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# ---- Claude ----
# cli = via Claude Code (abonnement) — la session de l'hôte est montée dans le conteneur
# api = via clé API Anthropic (facturé au token)
CLAUDE_MODE=cli
CLAUDE_MODEL=claude-opus-4-8
# CLAUDE_BIN : laisser vide en Docker, le binaire monté est détecté automatiquement
CLAUDE_BIN=

# ---- Docker : dossier home de l'hôte contenant .claude et .local/share/claude ----
HOST_HOME=/home/user
TZ=Europe/Paris

# ---- seulement si CLAUDE_MODE=api ----
ANTHROPIC_API_KEY=
MAX_TOKENS=1024

# ---- Service de mémoire externe (optionnel) ----
MEMORY_URL=
MEMORY_API_KEY=
